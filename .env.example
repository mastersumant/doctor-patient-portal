# ─────────────────────────────────────────────────────────────
# ClinicDesk environment template. Copy to .env.local (git-ignored) for local work.
# On Netlify, set the same names under Site configuration → Environment variables.
#
# Only VITE_* variables are sent to the browser. Everything else stays on the
# server. Never give a secret (sk_…, database password) a VITE_ name.
# ─────────────────────────────────────────────────────────────

# ── Frontend (browser) ───────────────────────────────────────

VITE_APP_NAME=ClinicDesk

# Clerk publishable key (pk_test_… or pk_live_…). Clerk Dashboard → API keys.
VITE_CLERK_PUBLISHABLE_KEY=

# Where records are stored:
#   INDEXEDDB → in this browser only (default; demo/prototype)
#   MEMORY    → in memory, lost when the tab closes (tests, kiosks)
#   API       → on the server: Netlify Function + Supabase Postgres (requires Clerk)
# netlify.toml sets API for deployed builds.
VITE_STORAGE_TYPE=INDEXEDDB

# Demo workspaces (synthetic doctors, no sign-in). Never offered in API mode.
#   empty → on when no Clerk key is set   true → always   false → never
VITE_ENABLE_DEMO_MODE=

# browser (clean URLs) | hash (static folders) | memory (embedded previews)
VITE_ROUTER_MODE=browser

# true only inside sandboxed preview frames that block downloads and printing.
VITE_SANDBOX_PREVIEW=false

# ── Server (Netlify Function, and `npm run dev:api` locally) ──

# Clerk secret key (sk_…). Clerk Dashboard → API keys. Verifies sign-in on every API call.
CLERK_SECRET_KEY=

# Supabase "Transaction pooler" connection string (port 6543), from the Connect button in
# your Supabase project. Locally, leave empty to use an embedded Postgres in ./.pglite.
DATABASE_URL=

# Connection string used by `npm run db:migrate` to create the tables. Use Supabase's
# "Session pooler" string (port 5432). Falls back to DATABASE_URL when empty.
MIGRATION_DATABASE_URL=

# Optional: comma-separated origins allowed to call the API, e.g. https://your-site.netlify.app
# Defaults to the site URLs Netlify provides (plus localhost outside production).
CLERK_AUTHORIZED_PARTIES=

# Optional: Clerk JWT public key (PEM) to verify tokens without a network call.
CLERK_JWT_KEY=

# Port for `npm run dev:api` (Vite proxies /api to it).
API_PORT=8787
