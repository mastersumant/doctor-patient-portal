# ─────────────────────────────────────────────────────────────
# ClinicDesk: frontend environment (copy to .env.local)
# Only variables prefixed with VITE_ are exposed to the browser.
# Never put secret keys (Clerk sk_…, database passwords) in this file.
# ─────────────────────────────────────────────────────────────

# Product name shown in the sidebar and sign-in page.
VITE_APP_NAME=ClinicDesk

# Clerk publishable key (starts with pk_test_ or pk_live_).
# Clerk Dashboard → API keys. Leave empty to run without sign-in
# (only the labelled demo workspaces are available then).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YnVyc3RpbmctZ2liYm9uLTQ2ODYuY2xlcmsuYWNjb3VudHMuZGV2JA

# Demo workspaces (two synthetic doctors, no sign-in).
#   empty → on when no Clerk key is set, off when one is
#   true  → always offer demo workspaces on the sign-in page
#   false → never offer them
VITE_ENABLE_DEMO_MODE=

# Persistence implementation used by the repository factory.
#   INDEXEDDB → browser database, survives reloads and restarts (default)
#   MEMORY    → in-memory only, cleared when the tab closes (tests, kiosks)
# Future: API (calls the REST backend described in docs/api-documentation.md)
VITE_STORAGE_TYPE=INDEXEDDB

# Router mode.
#   browser → clean URLs (/patients/PT-…); the host must serve index.html for all paths
#   hash    → URLs like /#/patients/…; works from any static folder (use `npm run build:static`)
#   memory  → no URL changes at all; for embedded or sandboxed previews
# Clerk's sign-in widget uses hash routing, so use `browser` mode with Clerk.
VITE_ROUTER_MODE=browser

# Set to true when the build runs inside a sandbox that blocks downloads and the
# print dialog (e.g. a hosted preview frame). Print buttons are hidden and
# downloads explain why they're unavailable.
VITE_SANDBOX_PREVIEW=false

# ─────────────────────────────────────────────────────────────
# Reserved for the future backend (not read by this frontend build)
# ─────────────────────────────────────────────────────────────
# STORAGE_TYPE=POSTGRESQL            # EXCEL | MYSQL | POSTGRESQL
# DATABASE_URL=postgresql://user:password@localhost:5432/clinicdesk
# CLERK_SECRET_KEY=sk_test_...       # server-side only, verifies session tokens
# FILE_STORAGE_DIR=./uploads
# MAX_UPLOAD_MB=10
