{
  "name": "doctor-patient-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:static": "tsc -b && VITE_ROUTER_MODE=hash vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "generate:data": "tsx --tsconfig scripts/tsconfig.json scripts/generate-data.ts",
    "dev:api": "tsx --tsconfig scripts/tsconfig.json scripts/dev-api.ts",
    "db:migrate": "tsx --tsconfig scripts/tsconfig.json scripts/db-migrate.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.27.0",
    "@clerk/react": "^6.18.6",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.72.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@netlify/functions": "^6.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
